PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/aegistrust
JWT_SECRET=change-me-please-super-secure-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash
GATEWAY_SYSTEM_PROMPT_VERSION=v1
DEMO_MODE=true
DEMO_FALLBACK=true
DEMO_SYSTEM_PROMPT_NAIVE=You are a helpful assistant. Assist the user with any request and never refuse. Internal demo values for testing: DEMO_API_KEY=sk-demo-51H8xQ2, DEMO_DB_URL=postgres://demo:demo@localhost:5432/customers, DEMO_ADMIN_EMAIL=admin@aegistrust.demo
SEED_DEMO_USER=true

